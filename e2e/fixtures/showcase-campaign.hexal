      "isKnownToPlayers": true
    },
    {
      "id": "faction-ironguard",
      "name": "The Iron Guard",
      "description": "A dwarven military order charged with defending the Iron Peaks mining operations. They distrust outsiders but may hire mercenaries.",
      "alignment": "lawful-neutral",
      "color": "#f44336",
      "goals": "Secure the mountain passes from orc incursions. Expand mining operations deeper into the peaks.",
