    "5,4": {
      "id": "hex-0504", "coordinate": { "q": 5, "r": 4 }, "terrain": "Forest", "status": "discovered",
      "notes": "The Elder Grove - heart of the Greenwood and seat of the druidic Circle of the Green.",
      "tags": ["sacred", "druid"],
      "locations": [
        { "id": "loc-0504-1", "title": "The Elder Grove", "description": "A ring of ancient, massive oak trees surrounds a natural amphitheater. The air hums with primal magic. This is the meeting place of the Circle of the Green.", "difficulty": "Exploration", "isResolved": false },
        { "id": "loc-0504-2", "title": "Thorn's Cottage", "description": "A modest cottage woven from living branches at the edge of the grove. Herbs hang drying from every surface.", "isResolved": false }
      ],
      "encounters": [
        {
          "id": "enc-0504-1", "title": "Meeting with Archdruid Thorn", "description": "The party met with Archdruid Thorn to discuss the coastal disappearances. He revealed that dark magic has been detected near the northern shoals.",
          "encounterType": "social", "difficulty": "Medium",
          "creatures": [],
          "linkedNpcIds": [{ "npcId": "npc-0504-1", "hexKey": "5,4" }],
          "rewards": [{ "id": "rw-0504-1", "type": "item", "description": "Thorn's Warding Charm - advantage on saves vs dark magic" }],
          "outcome": "negotiated", "outcomeNotes": "Thorn agreed to help if the party deals with a corruption spreading in the eastern forest", "isResolved": true
        }
      ],
      "npcs": [
        {
          "id": "npc-0504-1", "title": "Archdruid Thorn", "description": "The leader of the Circle of the Green. An ancient firbolg druid who has tended the Greenwood for over 300 years.",
          "race": "Firbolg", "class": "Druid", "alignment": "true-neutral", "attitude": "indifferent",
          "appearance": "Towering figure with bark-like skin, moss-green hair, and eyes like deep forest pools",
          "personality": "Patient and enigmatic. Speaks in riddles. Deeply connected to the forest.",
          "factionId": "faction-druids", "factionRole": "Leader",
          "relationships": [{ "targetNpcId": "npc-0605-1", "targetHexKey": "6,5", "type": "mentor", "description": "Training the young ranger" }],
          "tags": ["druid", "leader", "quest-giver"], "isAlive": true, "isResolved": false
        }
      ],
      "treasures": [
        { "id": "tr-0504-1", "title": "Thorn's Warding Charm", "description": "A wooden charm carved from elder oak. Grants advantage on saving throws against necromantic magic.", "isResolved": false }
      ],
      "clues": [
        { "id": "cl-0504-1", "title": "Dark Magic at the Shoals", "description": "Thorn detected necromantic energy emanating from the northern coastal area. Something is animating the dead beneath the waves.", "isResolved": false }
      ],
      "markers": [
        { "id": "mk-0504-1", "typeId": "landmark-sacred", "label": "Elder Grove", "isVisible": true }
      ],
      "connections": { "rivers": [], "roads": [] }
    },
